task.spawn(function()
    while true do
        task.wait(0.2)
        if espActive then
            for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
                if plr ~= p and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    local char = plr.Character
                    local bp = plr:FindFirstChildOfClass("Backpack")
                    
                    local hasGun = char:FindFirstChild("Gun") or (bp and bp:FindFirstChild("Gun"))
                    local hasKnife = char:FindFirstChild("Knife") or (bp and bp:FindFirstChild("Knife"))
                    
                    local color = Color3.fromRGB(0, 255, 0)
                    if hasGun then
                        color = Color3.fromRGB(0, 100, 255)
                    elseif hasKnife then
                        color = Color3.fromRGB(255, 0, 0)
                    end
                    
                    local hl = char:FindFirstChild("BombHubESP")
                    if not hl then
                        hl = Instance.new("Highlight")
                        hl.Name = "BombHubESP"
                        hl.Adornee = char
                        hl.Parent = char
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    end
                    hl.FillColor = color
                    hl.OutlineColor = color
                    hl.FillTransparency = 0.5
                elseif plr.Character and plr.Character:FindFirstChild("BombHubESP") then
                    plr.Character.BombHubESP:Destroy()
                end
            end
        else
            for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
                if plr.Character and plr.Character:FindFirstChild("BombHubESP") then
                    plr.Character.BombHubESP:Destroy()
                end
            end
        end
    end
end)

p.CharacterAdded:Connect(function(char)
    task.wait(1)
    if goldJumpActive then
        createGoldBombButton()
    end
    if fakeJumpActive then
        createFakeBombButton()
    end
    if gunActive then
        createGunButton()
    end
end)
