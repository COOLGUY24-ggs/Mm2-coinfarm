local function createGoldBombButton()
    if playerGui:FindFirstChild("GoldBombJumpGui") then
        playerGui.GoldBombJumpGui:Destroy()
    end

    local sg = Instance.new("ScreenGui", playerGui)
    sg.Name = "GoldBombJumpGui"
    sg.ResetOnSpawn = false

    local btn = Instance.new("TextButton", sg)
    btn.Size = UDim2.new(0, 130, 0, 45)
    btn.Position = savedGoldPosition
    btn.BackgroundColor3 = Color3.fromRGB(255, 170, 0)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = "Bomb Jump"
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 16
    btn.Active = true
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)

    local lockLabel = Instance.new("TextLabel", btn)
    lockLabel.Size = UDim2.new(0, 20, 0, 20)
    lockLabel.Position = UDim2.new(1, -22, 0, 2)
    lockLabel.BackgroundTransparency = 1
    lockLabel.Text = "🔒"
    lockLabel.TextSize = 14
    lockLabel.Visible = goldLockedPermanently

    local locked = goldLockedPermanently
    local dragging, dragStart, startPos = false, nil, nil
    local lastExecution = 0
    local lastClickTime = 0

    btn:GetPropertyChangedSignal("Position"):Connect(function()
        if sg.Parent and not locked then
            savedGoldPosition = btn.Position
        end
    end)

    btn.InputBegan:Connect(function(i)
        if not locked and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
            dragging = true
            dragStart = i.Position
            startPos = btn.Position
        end
    end)

    game:GetService("UserInputService").InputChanged:Connect(function(i)
        if dragging and not locked and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local delta = i.Position - dragStart
            btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            savedGoldPosition = btn.Position
        end
    end)

    btn.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then 
            dragging = false 
        end
    end)

    btn.MouseButton1Click:Connect(function()
        local currentTime = tick()
        if currentTime - lastClickTime <= 1 then
            if not locked then
                locked = true
                goldLockedPermanently = true
                lockLabel.Visible = true
                dragging = false
            end
            lastClickTime = 0
        else
            lastClickTime = currentTime
        end

        local now = tick()
        if now - lastExecution < 3.5 then
            btn.Text = "wait.."
            task.delay(1, function()
                if btn.Text == "wait.." then
                    btn.Text = "Bomb Jump"
                end
            end)
        else
            lastExecution = now
            local char = p.Character
            if char then
                local backpack = p:FindFirstChildOfClass("Backpack")
                local bomb = char:FindFirstChild("GoldBomb") or (backpack and backpack:FindFirstChild("GoldBomb"))
                
                if bomb and bomb.Parent == backpack then
                    bomb.Parent = char
                end
                
                local hum = char:FindFirstChildOfClass("Humanoid")
                local hrp = char:FindFirstChild("HumanoidRootPart")
                
                if hum and hrp then
                    local spawnCFrame = hrp.CFrame - Vector3.new(0, 3.2, 0)
                    local args = {
                        spawnCFrame,
                        50
                    }
                    pcall(function()
                        if char:FindFirstChild("GoldBomb") then
                            char.GoldBomb:WaitForChild("Remote"):FireServer(unpack(args))
                        end
                    end)
                    
                    task.wait(0.2)
                    hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, 55, hrp.AssemblyLinearVelocity.Z)
                end
            end
        end
    end)

    task.spawn(function()
        while goldJumpActive and sg.Parent do
            pcall(function()
                local args = {
                    "GoldBomb"
                }
                ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Extras"):WaitForChild("ReplicateToy"):InvokeServer(unpack(args))
            end)
            task.wait(3)
        end
    end)
end

