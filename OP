    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 20
    btn.Active = true
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 12)

    local lockLabel = Instance.new("TextLabel", btn)
    lockLabel.Size = UDim2.new(0, 20, 0, 20)
    lockLabel.Position = UDim2.new(1, -22, 0, 2)
    lockLabel.BackgroundTransparency = 1
    lockLabel.Text = "🔒"
    lockLabel.TextSize = 14
    lockLabel.Visible = gunLockedPermanently

    local locked = gunLockedPermanently
    local dragging, dragStart, startPos = false, nil, nil
    local lastClickTime = 0

    btn:GetPropertyChangedSignal("Position"):Connect(function()
        if sg.Parent and not locked then
            savedGunPosition = btn.Position
        end
    end)

    btn.InputBegan:Connect(function(i)
        if not locked and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
            dragging = true
            dragStart = i.Position
            startPos = btn.Position
        end
    end)

    game:GetService("UserInputService").InputChanged:Connect(function(i)
        if dragging and not locked and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local delta = i.Position - dragStart
            btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            savedGunPosition = btn.Position
        end
    end)

    btn.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then 
            dragging = false 
        end
    end)

    btn.MouseButton1Click:Connect(function()
        local currentTime = tick()
        if currentTime - lastClickTime <= 1 then
            if not locked then
                locked = true
                gunLockedPermanently = true
                lockLabel.Visible = true
                dragging = false
            end
            lastClickTime = 0
        else
            lastClickTime = currentTime
        end

        local char = p.Character
        local backpack = p:FindFirstChildOfClass("Backpack")
        
        local gun = (char and char:FindFirstChild("Gun")) or (backpack and backpack:FindFirstChild("Gun"))
        if not gun then
            btn.Text = "Ur not sheriff"
            task.delay(1.5, function()
                if btn.Text == "Ur not sheriff" then
                    btn.Text = "SHOOT"
                end
            end)
            return
        end

        if backpack and backpack:FindFirstChild("Gun") then
            if char then
                for _, child in ipairs(char:GetChildren()) do
                    if child:IsA("Tool") then
                        child.Parent = backpack
                    end
                end
            end
            backpack.Gun.Parent = char
        elseif char and not char:FindFirstChild("Gun") then
            for _, child in ipairs(char:GetChildren()) do
                if child:IsA("Tool") then
                    child.Parent = backpack
                end
            end
            gun.Parent = char
        else
            if char then
                for _, child in ipairs(char:GetChildren()) do
                    if child:IsA("Tool") and child.Name ~= "Gun" then
                        child.Parent = backpack
                    end
                end
            end
        end

        local murdererHrp = nil
        for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
            if plr ~= p and plr.Character then
                local pChar = plr.Character
                local pBackpack = plr:FindFirstChildOfClass("Backpack")
                local hasKnife = pChar:FindFirstChild("Knife") or (pBackpack and pBackpack:FindFirstChild("Knife"))
                if hasKnife then
                    murdererHrp = pChar:FindFirstChild("HumanoidRootPart")
                    break
                end
            end
        end

        if murdererHrp and char and char:FindFirstChild("Gun") then
            local gunTool = char:FindFirstChild("Gun")
            local shootRemote = gunTool:FindFirstChild("Shoot")
            if shootRemote then
                local startPosCFrame = gunTool:FindFirstChild("Handle") and gunTool.Handle.CFrame or char:FindFirstChild("HumanoidRootPart").CFrame
                local args = {
                    CFrame.new(startPosCFrame.Position, murdererHrp.Position),
                    murdererHrp.CFrame
                }
                pcall(function()
                    shootRemote:FireServer(unpack(args))
                end)
            end
        end
    end)
end

