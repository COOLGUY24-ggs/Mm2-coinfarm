                    mRoot.AssemblyLinearVelocity = Vector3.zero
                    mRoot.AssemblyAngularVelocity = Vector3.zero
                    task.wait(0.05)
                end

                humanoid.PlatformStand = oldPlatformStand
                Rayfield:Notify({ Title = "Success", Content = "Target process finished!", Duration = 3 })
            end)
        else
            Rayfield:Notify({ Title = "Error", Content = "No Murderer found in the game!", Duration = 3 })
        end
    end,
})

