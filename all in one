FlingTab:CreateToggle({
    Name = "Auto Fling on Touch (Proximity)",
    CurrentValue = false,
    Flag = "AutoTouchFlingToggle",
    Callback = function(Value)
        autoTouchFlingEnabled = Value
        if autoTouchFlingEnabled then
            if not autoTouchFlingConnection then
                autoTouchFlingConnection = RunService.Stepped:Connect(function()
                    if not autoTouchFlingEnabled or isFlinging then return end
                    local char = LocalPlayer.Character
                    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
                    local hrp = char.HumanoidRootPart
                    
                    for _, player in ipairs(Players:GetPlayers()) do
                        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                            local targetHrp = player.Character.HumanoidRootPart
                            local dist = (hrp.Position - targetHrp.Position).Magnitude
                            if dist < 4 then
                                executeFlingUntilDead(player.Character)
                                break
                            end
                        end
                    end
                end)
            end
        else
            if autoTouchFlingConnection then
                autoTouchFlingConnection:Disconnect()
                autoTouchFlingConnection = nil
            end
        end
    end,
})

