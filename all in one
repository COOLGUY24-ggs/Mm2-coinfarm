local reloadESP = function()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            
            if root and humanoid and humanoid.Health > 0 then
                local userIdStr = tostring(plr.UserId)
                local color = Color3.fromRGB(0, 255, 0)
                local roleText = "Innocent"

                local dataEntry = playerData[userIdStr] or playerData[plr.Name]
                if dataEntry then
                    local role = dataEntry.Role or dataEntry.RoleName or dataEntry.KRole
                    if role then
                        local rStr = string.lower(tostring(role))
                        if rStr:find("murd") or rStr:find("assassin") then
                            persistentRoles[userIdStr] = "Murderer"
                        elseif rStr:find("sheriff") or rStr:find("hero") then
                            persistentRoles[userIdStr] = "Sheriff"
                        elseif rStr:find("innocent") then
                            persistentRoles[userIdStr] = "Innocent"
                        end
                    end
                end

                local bp = plr:FindFirstChildOfClass("Backpack")
                local hasGun = char:FindFirstChild("Gun") or (bp and bp:FindFirstChild("Gun"))
                local hasKnife = char:FindFirstChild("Knife") or (bp and bp:FindFirstChild("Knife"))
                
                if hasGun then
                    persistentRoles[userIdStr] = "Sheriff"
                elseif hasKnife then
                    persistentRoles[userIdStr] = "Murderer"
                end

                local currentCachedRole = persistentRoles[userIdStr]
                if currentCachedRole == "Murderer" then
                    color = Color3.fromRGB(255, 0, 0)
                    roleText = "Murderer"
                elseif currentCachedRole == "Sheriff" then
                    color = Color3.fromRGB(0, 100, 255)
                    roleText = "Sheriff"
                else
                    color = Color3.fromRGB(0, 255, 0)
                    roleText = "Innocent"
                end

                local distFromZone = (root.Position - ZONE_CENTER).Magnitude
                local isInZone = distFromZone <= ZONE_RADIUS
                local hasCapitalWeapon = (char:FindFirstChild("Gun") or (bp and bp:FindFirstChild("Gun"))) or (char:FindFirstChild("Knife") or (bp and bp:FindFirstChild("Knife")))

                if isInZone and not hasCapitalWeapon then
                    color = Color3.fromRGB(255, 255, 255)
                end
                
                local hl = char:FindFirstChild("BombHubESP")
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "BombHubESP"
                    hl.Adornee = char
                    hl.Parent = char
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                end
                hl.FillColor = color
                hl.OutlineColor = color
                hl.FillTransparency = 0.5

                local textGui = char:FindFirstChild("RoleTextESP")
                if not textGui then
                    textGui = Instance.new("BillboardGui")
                    textGui.Name = "RoleTextESP"
                    textGui.Size = UDim2.new(0, 160, 0, 60)
                    textGui.StudsOffset = Vector3.new(0, 3, 0)
                    textGui.AlwaysOnTop = true
                    textGui.Parent = char

                    local label = Instance.new("TextLabel", textGui)
                    label.Name = "Title"
                    label.Size = UDim2.new(1, 0, 1, 0)
                    label.BackgroundTransparency = 1
                    label.TextScaled = true
                    label.Font = Enum.Font.SourceSansBold
                    label.TextStrokeTransparency = 0
                end

                local lbl = textGui:FindFirstChild("Title")
                if lbl then
                    if isInZone and not hasCapitalWeapon then
                        lbl.Text = plr.Name
                    else
                        lbl.Text = plr.Name .. "\n[" .. roleText .. "]"
                    end
                    lbl.TextColor3 = color
                end
            else
                if char:FindFirstChild("BombHubESP") then char.BombHubESP:Destroy() end
                if char:FindFirstChild("RoleTextESP") then char.RoleTextESP:Destroy() end
            end
        else
            if plr.Character then
                if plr.Character:FindFirstChild("BombHubESP") then plr.Character.BombHubESP:Destroy() end
                if plr.Character:FindFirstChild("RoleTextESP") then plr.Character.RoleTextESP:Destroy() end
            end
        end
    end
end

