    lockLabel.BackgroundTransparency = 1
    lockLabel.Text = "🔒"
    lockLabel.TextSize = 14
    lockLabel.Visible = goldLockedPermanently

    local locked = goldLockedPermanently
    local dragging, dragStart, startPos = false, nil, nil
