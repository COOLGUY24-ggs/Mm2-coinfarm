                    end
                end

                if coin and coin.Parent and coin:IsDescendantOf(workspace) then
                    local targetPosKey = tostring(math.floor(coin.Position.X)) .. "_" .. tostring(math.floor(coin.Position.Y)) .. "_" .. tostring(math.floor(coin.Position.Z))
                    
                    if undergroundFarmEnabled then
                        local belowCoinCFrame = coin.CFrame * CFrame.new(0, -5, 0)
                        local reached = smoothTweenToPosition(belowCoinCFrame, 1.5, coin)
                        if not reached or not coin or not coin.Parent then return end
                        
                        local char = LocalPlayer.Character
                        local root = char and char:FindFirstChild("HumanoidRootPart")
                        if not root then return end

                        root.CFrame = belowCoinCFrame
                        task.wait(0.05)

                        reached = smoothTweenToPosition(coin.CFrame, 1.5, coin)
                        if not reached or not coin or not coin.Parent then return end
                        
                        root.CFrame = coin.CFrame
                        task.wait(0.05)

                        smoothTweenToPosition(belowCoinCFrame, 1.5, nil)
                        root.CFrame = belowCoinCFrame
                    else
                        local reached = smoothTweenToPosition(coin.CFrame, 1.5, coin)
                        if not reached or not coin or not coin.Parent then return end
                        
                        local char = LocalPlayer.Character
                        local root = char and char:FindFirstChild("HumanoidRootPart")
                        if not root then return end

                        root.CFrame = coin.CFrame
                        task.wait(0.1)
                    end

                    if coin and coin.Parent and coin:IsDescendantOf(workspace) then
                        failedAttempts[targetPosKey] = (failedAttempts[targetPosKey] or 0) + 1
                        if failedAttempts[targetPosKey] >= maxAttemptsLimit then
                            failedAttempts[targetPosKey] = 0
                            handleStuckCombat()
                        end
                    else
                        failedAttempts[targetPosKey] = nil
                    end
                else
                    task.wait(0.2)
                end
            end)
        end
        task.wait(0.1)
    end
end)

-- --- ANTI-FLING & FLING LOGICA --- --

local function toggleAntiFling(state)
    antiFlingEnabled = state
    if antiFlingEnabled then
        if not antiFlingConnection then
            antiFlingConnection = RunService.Stepped:Connect(function()
                if not antiFlingEnabled then return end
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer and player.Character then
                        for _, targetPart in ipairs(player.Character:GetDescendants()) do
                            if targetPart:IsA("BasePart") then
                                targetPart.CanCollide = false
                            end
                        end
                    end
                end
            end)
        end
    else
        if antiFlingConnection then
            antiFlingConnection:Disconnect()
            antiFlingConnection = nil
        end
    end
end

local function executeFlingUntilDead(targetChar)
    if isFlinging then return end
    local localChar = LocalPlayer.Character
    if not localChar then return end
    
    local localRoot = getRoot(localChar)
    local targetRoot = getRoot(targetChar)
    local humanoid = localChar:FindFirstChild("Humanoid")
    local targetHumanoid = targetChar:FindFirstChild("Humanoid")
    
    if not localRoot or not targetRoot or not humanoid or not targetHumanoid then return end
    
    isFlinging = true
    local previousAntiFlingState = antiFlingEnabled
    if previousAntiFlingState then toggleAntiFling(false) end
    
    local startCFrame = localRoot.CFrame
    humanoid.PlatformStand = true
    
    for _, part in ipairs(localChar:GetChildren()) do
        if part:IsA("BasePart") then
            part.CanCollide = (part == localRoot)
        end
    end
    
    local bAV = Instance.new("BodyAngularVelocity")
    bAV.Name = "FlingForce"
    bAV.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bAV.AngularVelocity = Vector3.new(0, 999999, 0)
    bAV.Parent = localRoot

    local bV = Instance.new("BodyVelocity")
    bV.Name = "FlingMove"
    bV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bV.Velocity = Vector3.new(0, 0, 0)
    bV.Parent = localRoot
    
    task.spawn(function()
        local connection
        local toggleJitter = false
        
        connection = RunService.Heartbeat:Connect(function()
            if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("Humanoid") or LocalPlayer.Character.Humanoid.Health <= 0 then
                connection:Disconnect()
                return
            end
            
            local freshTargetRoot = getRoot(targetChar)
            local freshTargetHumanoid = targetChar:FindFirstChild("Humanoid")
            
            if not freshTargetRoot or not freshTargetHumanoid or freshTargetHumanoid.Health <= 0 or not targetChar:IsDescendantOf(workspace) then
                connection:Disconnect()
                return
            end
            
            local targetVel = freshTargetRoot.AssemblyLinearVelocity
            local predictionMult = targetVel.Magnitude < 1 and 0 or 0.12
            local predictedPosition = freshTargetRoot.Position + (targetVel * predictionMult)
            
            toggleJitter = not toggleJitter
            local offset = toggleJitter and Vector3.new(0, 0.1, 0) or Vector3.new(0, -0.1, 0)
            
            localRoot.CFrame = CFrame.new(predictedPosition + offset) * CFrame.Angles(math.rad(math.random(-180, 180)), math.rad(math.random(-180, 180)), math.rad(math.random(-180, 180)))
            localRoot.Velocity = Vector3.new(99999, 99999, 99999)
            localRoot.RotVelocity = Vector3.new(99999, 999999, 99999)
        end)
        
        repeat task.wait(0.05) until not connection.Connected
        
        if bAV then bAV:Destroy() end
        if bV then bV:Destroy() end
        
        if localRoot then
            localRoot.Velocity = Vector3.zero
            localRoot.RotVelocity = Vector3.zero
            localRoot.CFrame = startCFrame
        end
        
        task.wait(0.05)
        
        for _, part in ipairs(localChar:GetChildren()) do
            if part:IsA("BasePart") then part.CanCollide = true end
        end
        
        if humanoid then
            humanoid.PlatformStand = false
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
        
        if previousAntiFlingState then toggleAntiFling(true) end
        isFlinging = false
        
        Rayfield:Notify({ Title = "Target Eliminated", Content = "Target successfully flung!", Duration = 3 })
    end)
end

