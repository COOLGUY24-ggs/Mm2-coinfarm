                        dragging = false
                    end
                    lastClickTime = 0
                else
                    lastClickTime = currentTime

                    local char = LocalPlayer.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
                    if not hrp then return end

                    local gun = (char and char:FindFirstChild("Gun")) or (backpack and backpack:FindFirstChild("Gun"))
                    local knife = (char and char:FindFirstChild("Knife")) or (backpack and backpack:FindFirstChild("Knife"))

                    if not gun and knife then
                        if backpack and backpack:FindFirstChild("Knife") then
                            for _, child in ipairs(char:GetChildren()) do if child:IsA("Tool") then child.Parent = backpack end end
                            backpack.Knife.Parent = char
                        end

                        local targetHrp = nil
                        local shortestDist = math.huge
                        for _, plr in ipairs(Players:GetPlayers()) do
                            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                                local pHum = plr.Character:FindFirstChildOfClass("Humanoid")
                                if pHum and pHum.Health > 0 then
                                    local dist = (hrp.Position - plr.Character.HumanoidRootPart.Position).Magnitude
                                    if dist < shortestDist then
                                        shortestDist = dist
                                        targetHrp = plr.Character.HumanoidRootPart
                                    end
                                end
                            end
                        end

                        local knifeTool = char and char:FindFirstChild("Knife")
                        local throwRemote = knifeTool and knifeTool:FindFirstChild("Events") and knifeTool.Events:FindFirstChild("KnifeThrown")

                        if targetHrp and throwRemote then
                            local knifeHandle = knifeTool:FindFirstChild("Handle")
                            local startPosCFrame = knifeHandle and knifeHandle.CFrame or hrp.CFrame
                            
                            local predictedPos = getAdvancedPredictedPosition(hrp, targetHrp, 130)
                            if farModeEnabled then
                                predictedPos = predictedPos + (targetHrp.AssemblyLinearVelocity * 1.0)
                            end

                            local args = {
                                CFrame.new(startPosCFrame.Position, predictedPos),
                                targetHrp.CFrame
                            }
                            pcall(function() throwRemote:FireServer(unpack(args)) end)
                        end
                        return
                    end

                    if not gun then
                        btn.Text = "No gun/knife"
                        task.delay(1.5, function() if btn.Text == "No gun/knife" then btn.Text = "SHOOT" end end)
                        return
                    end

                    if backpack and backpack:FindFirstChild("Gun") then
                        for _, child in ipairs(char:GetChildren()) do if child:IsA("Tool") then child.Parent = backpack end end
                        backpack.Gun.Parent = char
                    end

                    local murdererHrp = nil
                    local shortestMurdererDist = math.huge
                    for _, plr in ipairs(Players:GetPlayers()) do
                        if plr ~= LocalPlayer and plr.Character then
                            local pChar = plr.Character
                            local pBackpack = plr:FindFirstChildOfClass("Backpack")
                            local pHum = pChar:FindFirstChildOfClass("Humanoid")
                            local pRoot = pChar:FindFirstChild("HumanoidRootPart")
                            
                            if pHum and pHum.Health > 0 and pRoot then
                                local hasKnife = pChar:FindFirstChild("Knife") or (pBackpack and pBackpack:FindFirstChild("Knife"))
                                if hasKnife then
                                    local dist = (hrp.Position - pRoot.Position).Magnitude
                                    if dist < shortestMurdererDist then
