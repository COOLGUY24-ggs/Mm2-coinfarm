local function getCollectedCoins()
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        for _, stat in ipairs(leaderstats:GetChildren()) do
            if string.lower(stat.Name):find("coin") and (stat:IsA("IntValue") or stat:IsA("NumberValue")) then
                return stat.Value
            end
        end
    end
    
    local guiContainer = LocalPlayer:FindFirstChild("PlayerGui")
    if guiContainer then
        for _, gui in ipairs(guiContainer:GetDescendants()) do
            if gui:IsA("TextLabel") and (string.lower(gui.Name):find("coin") or string.lower(gui.Text):find("/")) then
                local currentCount = tonumber(string.match(gui.Text, "^(%d+)"))
                if currentCount then
                    return currentCount
                end
            end
        end
    end
    
    return 0
end

local function isBlacklistedPosition(pos)
    local blacklistedCenter = Vector3.new(-21, 242, 9095)
    return (Vector3.new(pos.X, pos.Y, pos.Z) - blacklistedCenter).Magnitude <= 15
end

local function getSelectedCoin()
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end

    local coinList = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name == "Coin" or obj.Name == "CoinVisual" or obj:FindFirstChild("TouchInterest")) then
            if obj.Parent and (obj.Parent.Name == "CoinContainer" or obj.Parent.Name == "Coins" or obj.Name == "Coin") then
                if not isBlacklistedPosition(obj.Position) then
                    local dist = (rootPart.Position - obj.Position).Magnitude
                    if dist <= MAX_DISTANCE then
                        table.insert(coinList, obj)
                    end
                end
            end
        end
    end

    if #coinList == 0 then return nil end

    if coinMode == "Closest" then
        local nearestCoin = nil
        local shortestDistance = math.huge
        for _, coin in ipairs(coinList) do
            local dist = (rootPart.Position - coin.Position).Magnitude
            if dist < shortestDistance then
                shortestDistance = dist
                nearestCoin = coin
            end
        end
        return nearestCoin
    elseif coinMode == "Farthest" then
        local farthestCoin = nil
        local longestDistance = -1
        for _, coin in ipairs(coinList) do
            local dist = (rootPart.Position - coin.Position).Magnitude
            if dist > longestDistance then
                longestDistance = dist
                farthestCoin = coin
            end
        end
        return farthestCoin
    elseif coinMode == "Random" then
        return coinList[math.random(1, #coinList)]
    end

    return coinList[1]
end

local function smoothTweenToPosition(targetCFrame, earlyDistance, targetCoinInstance)
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    
    if not rootPart or not humanoid then return false end

    local oldPlatformStand = humanoid.PlatformStand
    humanoid.PlatformStand = true

    local distance = (rootPart.Position - targetCFrame.Position).Magnitude
    if distance <= 0 then 
        humanoid.PlatformStand = oldPlatformStand
        return true 
    end
    
    local duration = distance / tweenSpeed
    local startTime = tick()
    local startCFrame = rootPart.CFrame
    local stopDistance = earlyDistance or 0

    while tick() - startTime < duration do
        if not autoFarmEnabled then break end
        if not LocalPlayer.Character or not rootPart.Parent then break end
        
        if targetCoinInstance and (not targetCoinInstance.Parent or not targetCoinInstance:IsDescendantOf(workspace)) then
            humanoid.PlatformStand = oldPlatformStand
            return false
        end

        local currentDist = (rootPart.Position - targetCFrame.Position).Magnitude
        if stopDistance > 0 and currentDist <= stopDistance then
            break
        end

        local alpha = math.clamp((tick() - startTime) / duration, 0, 1)
        rootPart.CFrame = startCFrame:Lerp(targetCFrame, alpha)
        rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        
        RunService.Heartbeat:Wait()
    end
    
    if targetCoinInstance and (not targetCoinInstance.Parent or not targetCoinInstance:IsDescendantOf(workspace)) then
        humanoid.PlatformStand = oldPlatformStand
        return false
    end

    if rootPart and rootPart.Parent and stopDistance <= 0 then
        rootPart.CFrame = targetCFrame
    end
    
    if humanoid and humanoid.Parent then
        humanoid.PlatformStand = oldPlatformStand
    end

    return true
end

