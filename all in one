-- --- PREDICTION FUNCTION --- --
local function getAdvancedPredictedPosition(shooterHrp, targetHrp, projectileSpeed)
    local targetPos = targetHrp.Position
    local targetVel = targetHrp.AssemblyLinearVelocity
    local shooterVel = shooterHrp.AssemblyLinearVelocity

    if targetVel.Magnitude < 0.5 then
        return targetPos
    end

    local relativeVel = targetVel - shooterVel
    local distance = (shooterHrp.Position - targetPos).Magnitude
    local timeOfFlight = distance / projectileSpeed

    local predictionFactor = 0.65

    if distance >= 35 then
        predictionFactor = 1.15
    elseif distance >= 25 then
        predictionFactor = 0.90
    elseif distance >= 15 then
        predictionFactor = 0.60
    else
        predictionFactor = 0.25
    end

    local predictedPos = targetPos + (relativeVel * (timeOfFlight * predictionFactor))
    return predictedPos
end

