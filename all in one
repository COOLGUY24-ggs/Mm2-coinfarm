local function applyDroppedGunESP(object)
    if object and (object.Name == "GunDrop" or object.Name == "Gundrop" or object.Name:lower() == "gundrop") then
        if not object:FindFirstChild("GunTextESP") then
            local textGui = Instance.new("BillboardGui")
            textGui.Name = "GunTextESP"
            textGui.Size = UDim2.new(0, 160, 0, 50)
            textGui.StudsOffset = Vector3.new(0, 2.5, 0)
            textGui.AlwaysOnTop = true
            textGui.Parent = object

            local label = Instance.new("TextLabel", textGui)
            label.Size = UDim2.new(1, 0, 1, 0)
            label.BackgroundTransparency = 1
            label.Text = "DROPPED GUN"
            label.TextColor3 = Color3.fromRGB(255, 255, 0)
            label.TextScaled = true
            label.Font = Enum.Font.SourceSansBold
            label.TextStrokeTransparency = 0
            label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        end

        if not object:FindFirstChild("GunHighlightESP") then
            local highlight = Instance.new("Highlight")
            highlight.Name = "GunHighlightESP"
            highlight.Adornee = object
            highlight.FillColor = Color3.fromRGB(255, 255, 0)
