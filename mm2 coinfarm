local function getCollectedCoins()
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        for _, stat in ipairs(leaderstats:GetChildren()) do
            if string.lower(stat.Name):find("coin") and (stat:IsA("IntValue") or stat:IsA("NumberValue")) then
                return stat.Value
            end
        end
    end
    
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        for _, gui in ipairs(playerGui:GetDescendants()) do
            if gui:IsA("TextLabel") and (string.lower(gui.Name):find("coin") or string.lower(gui.Text):find("/")) then
                local currentCount = tonumber(string.match(gui.Text, "^(%d+)"))
                if currentCount then
                    return currentCount
                end
            end
        end
    end
    
    return 0
end

local function getSelectedCoin()
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end

    local coinList = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name == "Coin" or obj.Name == "CoinVisual" or obj:FindFirstChild("TouchInterest")) then
            if obj.Parent and (obj.Parent.Name == "CoinContainer" or obj.Parent.Name == "Coins" or obj.Name == "Coin") then
                local dist = (rootPart.Position - obj.Position).Magnitude
                if dist <= MAX_DISTANCE then
                    table.insert(coinList, obj)
                end
            end
        end
    end

    if #coinList == 0 then return nil end

    if coinMode == "Closest" then
        local nearestCoin = nil
        local shortestDistance = math.huge
        for _, coin in ipairs(coinList) do
            local dist = (rootPart.Position - coin.Position).Magnitude
            if dist < shortestDistance then
                shortestDistance = dist
                nearestCoin = coin
            end
        end
        return nearestCoin

    elseif coinMode == "Farthest" then
        local farthestCoin = nil
        local longestDistance = -1
        for _, coin in ipairs(coinList) do
            local dist = (rootPart.Position - coin.Position).Magnitude
            if dist > longestDistance then
                longestDistance = dist
                farthestCoin = coin
            end
        end
        return farthestCoin

    elseif coinMode == "Random" then
        return coinList[math.random(1, #coinList)]
    end

    return coinList[1]
end

local function smoothTweenToPosition(targetCFrame)
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    
    if not rootPart or not humanoid then return end

    local oldPlatformStand = humanoid.PlatformStand
    humanoid.PlatformStand = true

    local distance = (rootPart.Position - targetCFrame.Position).Magnitude
    if distance <= 0 then 
        humanoid.PlatformStand = oldPlatformStand
        return 
    end
    
    local duration = distance / tweenSpeed
    local startTime = tick()
    local startCFrame = rootPart.CFrame

    while tick() - startTime < duration do
        if not autoFarmEnabled then break end
        if not LocalPlayer.Character or not rootPart.Parent then break end
        
        local alpha = math.clamp((tick() - startTime) / duration, 0, 1)
        rootPart.CFrame = startCFrame:Lerp(targetCFrame, alpha)
        
        rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        
        RunService.Heartbeat:Wait()
    end
    
    if rootPart and rootPart.Parent then
        rootPart.CFrame = targetCFrame
    end
    
    if humanoid and humanoid.Parent then
        humanoid.PlatformStand = oldPlatformStand
    end
end

local function getWeapon(weaponName)
    local character = LocalPlayer.Character
    if character and character:FindFirstChild(weaponName) then
        return character:FindFirstChild(weaponName)
    end
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if backpack and backpack:FindFirstChild(weaponName) then
        return backpack:FindFirstChild(weaponName)
    end
    return nil
end

local function findMurderer()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            if char:FindFirstChild("Knife") or (player.Backpack and player.Backpack:FindFirstChild("Knife")) then
                return player
            end
        end
    end
    return nil
end

local function clickScreenCenter()
    pcall(function()
        local viewportSize = Camera.ViewportSize
        local centerX = (viewportSize.X / 2) + 25
        local centerY = viewportSize.Y / 2
        local screenPos = Vector2.new(centerX, centerY)

        VirtualUser:Button1Down(screenPos)
        task.wait(0.05)
        VirtualUser:Button1Up(screenPos)
    end)
end

local function isSheriff()
    return getWeapon("Gun") ~= nil
end

local function handleStuckCombat()
    if isExecutingCombat then return end
    isExecutingCombat = true

    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")

    if not character or not humanoid or not rootPart or humanoid.Health <= 0 then
        isExecutingCombat = false
        return
    end

    local knife = getWeapon("Knife")
    local gun = getWeapon("Gun")

    if autoResetEnabled and isSheriff() then
        Rayfield:Notify({ Title = "Sheriff Detected", Content = "You are Sheriff! Resetting character...", Duration = 3 })
        humanoid.Health = 0
        task.wait(4)
        isExecutingCombat = false
        return
    end

    if knife then
        Rayfield:Notify({ Title = "Stuck Combat", Content = "Equipping Knife and killing everyone...", Duration = 3 })
        humanoid:EquipTool(knife)
        
        local targets = {}
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local pHum = player.Character:FindFirstChildOfClass("Humanoid")
                if pHum and pHum.Health > 0 then
                    table.insert(targets, player)
                end
            end
        end

        for _, targetPlayer in ipairs(targets) do
            local targetChar = targetPlayer.Character
            local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
            local targetHum = targetChar and targetChar:FindFirstChild("Humanoid")

            while autoFarmEnabled and targetRoot and targetHum and targetHum.Health > 0 and humanoid.Health > 0 do
                targetRoot.CFrame = rootPart.CFrame * CFrame.new(0, 0, -2)
                clickScreenCenter()
                task.wait(0.2)
            end
        end

    elseif gun then
        Rayfield:Notify({ Title = "Stuck Combat", Content = "Aimlocking & Firing 3 studs in front of you...", Duration = 3 })
        humanoid:EquipTool(gun)
        
        LocalPlayer.CameraMinZoomDistance = 0.5
        LocalPlayer.CameraMaxZoomDistance = 0.5
        
        local murderer = findMurderer()
        local startTime = tick()
        
        while autoFarmEnabled and murderer and murderer.Character and humanoid.Health > 0 and (tick() - startTime < 8) do
            local mRoot = murderer.Character:FindFirstChild("HumanoidRootPart")
            local mHum = murderer.Character:FindFirstChild("Humanoid") or murderer.Character:FindFirstChildOfClass("Humanoid")
            if not mRoot or not mHum or mHum.Health <= 0 then break end

            mRoot.CFrame = rootPart.CFrame * CFrame.new(0, 0, -3)
            
            local aimTargetPos = mRoot.Position + Vector3.new(0, 0.5, 0)
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, aimTargetPos)
            
            pcall(function()
                local gunTool = character:FindFirstChild("Gun") or LocalPlayer.Backpack:FindFirstChild("Gun")
                if gunTool then
                    if gunTool.Parent ~= character then
                        humanoid:EquipTool(gunTool)
                    end
                    local shootRemote = gunTool:FindFirstChild("Shoot")
                    if shootRemote then
                        local args = {
                            CFrame.new(rootPart.Position, mRoot.Position),
                            mRoot.CFrame
                        }
                        shootRemote:FireServer(unpack(args))
                    end
                end
            end)
            
            clickScreenCenter()
            task.wait(0.1)
        end
        
        LocalPlayer.CameraMinZoomDistance = 10
        LocalPlayer.CameraMaxZoomDistance = 400
    else
        if autoResetEnabled and humanoid then
            Rayfield:Notify({ Title = "Stuck Detected", Content = "No weapon found! Resetting character...", Duration = 3 })
            humanoid.Health = 0
            task.wait(4)
        end
    end

    isExecutingCombat = false
end

-- Coin Farm Loop with Stuck/Attempt Counter and Combat Logic
task.spawn(function()
    while true do
        if autoFarmEnabled and not isExecutingCombat then
            pcall(function()
                local currentCoins = getCollectedCoins()
                if currentCoins >= 40 then
                    autoFarmEnabled = false
                    Rayfield:Notify({ 
                        Title = "Auto Farm Completed", 
                        Content = "Reached 40 collected coins! Farm stopped automatically.", 
                        Duration = 5 
                    })
                    return
                end

                local coin = getSelectedCoin()
                if coin then
                    local targetPosKey = tostring(math.floor(coin.Position.X)) .. "_" .. tostring(math.floor(coin.Position.Y)) .. "_" .. tostring(math.floor(coin.Position.Z))
                    
                    smoothTweenToPosition(coin.CFrame)
                    
                    local char = LocalPlayer.Character
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    if coin and coin.Parent and root then
                        root.CFrame = coin.CFrame
                        task.wait(0.1)
                    end

                    if coin and coin.Parent then
                        failedAttempts[targetPosKey] = (failedAttempts[targetPosKey] or 0) + 1
                        if failedAttempts[targetPosKey] >= maxAttemptsLimit then
                            failedAttempts[targetPosKey] = 0
                            handleStuckCombat()
                        end
                    else
                        failedAttempts[targetPosKey] = nil
                    end
                else
                    task.wait(1)
                end
            end)
        end
        task.wait(0.1)
    end
end)

