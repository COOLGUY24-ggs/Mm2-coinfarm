--[[
    Project: MM2 Dynamic Prediction Continuous Fling
    Language: English
]]

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "MM2 Ultimate Fling",
   LoadingTitle = "Loading Menu...",
   LoadingSubtitle = "by Helper",
   ConfigurationSaving = { Enabled = false },
   KeySystem = false,
})

local Tab = Window:CreateTab("Fling", 4483362458)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local targetPlayerName = ""
local isFlinging = false
local antiFlingEnabled = false
local antiFlingConnection = nil

local function getRoot(char)
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
end

-- Anti-Fling Logic
local function toggleAntiFling(state)
    antiFlingEnabled = state
    
    if antiFlingEnabled then
        if not antiFlingConnection then
            antiFlingConnection = RunService.Stepped:Connect(function()
                if not antiFlingEnabled then return end
                
                local localChar = LocalPlayer.Character
                if not localChar then return end
                
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer and player.Character then
                        for _, targetPart in ipairs(player.Character:GetDescendants()) do
                            if targetPart:IsA("BasePart") then
                                targetPart.CanCollide = false
                            end
                        end
                    end
                end
            end)
        end
    else
        if antiFlingConnection then
            antiFlingConnection:Disconnect()
            antiFlingConnection = nil
        end
    end
end

local function executeFlingUntilDead(targetChar)
    if isFlinging then return end
    local localChar = LocalPlayer.Character
    if not localChar then return end
    
    local localRoot = getRoot(localChar)
    local targetRoot = getRoot(targetChar)
    local humanoid = localChar:FindFirstChild("Humanoid")
    local targetHumanoid = targetChar:FindFirstChild("Humanoid")
    
    if not localRoot or not targetRoot or not humanoid or not targetHumanoid then return end
    
    isFlinging = true
    local previousAntiFlingState = antiFlingEnabled
    
    if previousAntiFlingState then
        toggleAntiFling(false)
    end
    
    local startCFrame = localRoot.CFrame
    
    humanoid.PlatformStand = true
    
    -- Force collision on local root
    for _, part in ipairs(localChar:GetChildren()) do
        if part:IsA("BasePart") then
            part.CanCollide = (part == localRoot)
        end
    end
    
    -- Physics force elements
    local bAV = Instance.new("BodyAngularVelocity")
    bAV.Name = "FlingForce"
    bAV.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bAV.AngularVelocity = Vector3.new(0, 999999, 0)
    bAV.Parent = localRoot

    local bV = Instance.new("BodyVelocity")
    bV.Name = "FlingMove"
    bV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bV.Velocity = Vector3.new(0, 0, 0)
    bV.Parent = localRoot
    
    task.spawn(function()
        local connection
        local toggleJitter = false
        
        -- High-frequency Heartbeat tracking for moving targets
        connection = RunService.Heartbeat:Connect(function()
            if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("Humanoid") or LocalPlayer.Character.Humanoid.Health <= 0 then
                connection:Disconnect()
                return
            end
            
            local freshTargetRoot = getRoot(targetChar)
            local freshTargetHumanoid = targetChar:FindFirstChild("Humanoid")
            
            if not freshTargetRoot or not freshTargetHumanoid or freshTargetHumanoid.Health <= 0 or not targetChar:IsDescendantOf(workspace) then
                connection:Disconnect()
                return
            end
            
            -- Dynamic movement prediction based on target velocity
            local targetVel = freshTargetRoot.AssemblyLinearVelocity
            local predictionMult = 0.12
            
            if targetVel.Magnitude < 1 then
                predictionMult = 0 -- Target standing still
            end
            
            local predictedPosition = freshTargetRoot.Position + (targetVel * predictionMult)
            
            -- Alternating micro-jitter to force constant physics overlap
            toggleJitter = not toggleJitter
            local offset = toggleJitter and Vector3.new(0, 0.1, 0) or Vector3.new(0, -0.1, 0)
            
            localRoot.CFrame = CFrame.new(predictedPosition + offset) * CFrame.Angles(math.rad(math.random(-180, 180)), math.rad(math.random(-180, 180)), math.rad(math.random(-180, 180)))
            localRoot.Velocity = Vector3.new(99999, 99999, 99999)
            localRoot.RotVelocity = Vector3.new(99999, 999999, 99999)
        end)
        
        -- Hold loop active until disconnect
        repeat
            task.wait(0.05)
        until not connection.Connected
        
        -- Clean up forces
        if bAV then bAV:Destroy() end
        if bV then bV:Destroy() end
        
        -- Return to starting CFrame safely
        if localRoot then
            localRoot.Velocity = Vector3.zero
            localRoot.RotVelocity = Vector3.zero
            localRoot.CFrame = startCFrame
        end
        
        task.wait(0.05)
        
        if localRoot then
            localRoot.Velocity = Vector3.zero
            localRoot.RotVelocity = Vector3.zero
        end
        
        for _, part in ipairs(localChar:GetChildren()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
        
        if humanoid then
            humanoid.PlatformStand = false
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
        
        if previousAntiFlingState then
            toggleAntiFling(true)
        end
        
        isFlinging = false
        
        Rayfield:Notify({
           Title = "Target Eliminated",
           Content = "Target was completely flinged!",
           Duration = 3,
        })
    end)
end

-- UI Elements
Tab:CreateToggle({
   Name = "Enable Anti-Fling",
   CurrentValue = false,
   Flag = "AntiFlingToggle",
   Callback = function(Value)
      toggleAntiFling(Value)
   end,
})

Tab:CreateInput({
   Name = "Target Player Name",
   PlaceholderText = "Enter full or partial name",
   RemoveTextAfterFocusLost = false,
   Callback = function(text)
      targetPlayerName = text
   end,
})

Tab:CreateButton({
   Name = "Run TouchFling (Dynamic Tracking)",
   Callback = function()
      local target = nil
      for _, player in ipairs(Players:GetPlayers()) do
         if player ~= LocalPlayer and string.sub(string.lower(player.Name), 1, string.len(targetPlayerName)) == string.lower(targetPlayerName) then
            target = player
            break
         end
      end
      
      if target and target.Character then
         executeFlingUntilDead(target.Character)
      else
         Rayfield:Notify({
            Title = "Error",
            Content = "Player not found!",
            Duration = 3,
         })
      end
   end,
})

Tab:CreateButton({
   Name = "Fling Murderer Safely",
   Callback = function()
      local murderer = nil
      
      for _, player in ipairs(Players:GetPlayers()) do
         if player ~= LocalPlayer then
            local char = player.Character
            local backpack = player:FindFirstChild("Backpack")
            local hasKnife = false
            
            if char then
               for _, item in ipairs(char:GetChildren()) do
                  if item:IsA("Tool") and (string.find(string.lower(item.Name), "knife") or string.lower(item.Name) == "knife") then
                     hasKnife = true
                     break
                  end
               end
            end
            
            if not hasKnife and backpack then
               for _, item in ipairs(backpack:GetChildren()) do
                  if item:IsA("Tool") and (string.find(string.lower(item.Name), "knife") or string.lower(item.Name) == "knife") then
                     hasKnife = true
                     break
                  end
               end
            end
            
            if hasKnife then
               murderer = player
               break
            end
         end
      end
      
      if murderer and murderer.Character then
         Rayfield:Notify({
            Title = "Murderer Found!",
            Content = "Executing dynamic fling on " .. murderer.Name,
            Duration = 3,
         })
         executeFlingUntilDead(murderer.Character)
      else
         Rayfield:Notify({
            Title = "Error",
            Content = "No Murderer with a knife found yet!",
            Duration = 3,
         })
      end
   end,
})
